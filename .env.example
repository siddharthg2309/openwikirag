OPENWIKIRAG_ENVIRONMENT=development
OPENWIKIRAG_LOG_LEVEL=INFO
OPENWIKIRAG_API_HOST=127.0.0.1
OPENWIKIRAG_API_PORT=8000
OPENWIKIRAG_DATABASE_URL=postgresql+asyncpg://openwikirag_app:openwikirag-dev-password@127.0.0.1:5432/openwikirag
OPENWIKIRAG_MIGRATION_DATABASE_URL=postgresql+asyncpg://openwikirag:openwikirag-dev-password@127.0.0.1:5432/openwikirag
OPENWIKIRAG_JWT_SECRET=replace-with-a-long-development-secret-at-least-32-chars
OPENWIKIRAG_JWT_ISSUER=openwikirag-local
OPENWIKIRAG_JWT_AUDIENCE=openwikirag-api
OPENWIKIRAG_ACCESS_TOKEN_TTL_SECONDS=900
OPENWIKIRAG_REFRESH_TOKEN_TTL_DAYS=30
OPENWIKIRAG_REDIS_URL=redis://127.0.0.1:6379/0
OPENWIKIRAG_INGESTION_STREAM_NAME=openwikirag:ingestion
OPENWIKIRAG_OUTBOX_BATCH_SIZE=100
OPENWIKIRAG_INGESTION_CONSUMER_GROUP=openwikirag-ingestion
OPENWIKIRAG_INGESTION_CONSUMER_NAME=local-worker
OPENWIKIRAG_JOB_LEASE_SECONDS=60
OPENWIKIRAG_JOB_RETRY_BACKOFF_BASE_SECONDS=5
OPENWIKIRAG_JOB_RETRY_BACKOFF_MAX_SECONDS=300
OPENWIKIRAG_DEAD_LETTER_STREAM_NAME=openwikirag:ingestion:dead-letter
OPENWIKIRAG_WORKER_POLL_INTERVAL_SECONDS=1
OPENWIKIRAG_WORKER_ERROR_BACKOFF_SECONDS=5
OPENWIKIRAG_OCR_ENABLED=false
OPENWIKIRAG_OCR_DPI=200
OPENWIKIRAG_OCR_LANGUAGE=eng
OPENWIKIRAG_OCR_PAGE_SEGMENTATION_MODE=6
OPENWIKIRAG_OCR_TIMEOUT_SECONDS=30
OPENWIKIRAG_OCR_MAX_PAGES=50

# Local-only dependency credentials. Never use these values outside development.
POSTGRES_DB=openwikirag
POSTGRES_USER=openwikirag
POSTGRES_PASSWORD=openwikirag-dev-password
POSTGRES_APP_PASSWORD=openwikirag-dev-password
NEO4J_PASSWORD=openwikirag-dev-password
MINIO_ROOT_USER=openwikirag
MINIO_ROOT_PASSWORD=openwikirag-dev-password
